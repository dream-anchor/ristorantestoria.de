# ============================================
# ristorantestoria.de — Alle Regeln
# ============================================
# Single Source of Truth für alle Redirects, Routing, Caching.
# Root-.htaccess leitet nur Requests hierher (kein 301 dort).

AddDefaultCharset UTF-8
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# ============================================
# 0. Einzel-Hop Canonical-Fixes (vor Host-Kanonisierung)
# ============================================
# /reisegruppen ohne Slash → finale URL in EINEM 301-Sprung.
# Greift host-unabhängig (Regel schreibt absolute Ziel-URL), verhindert
# so die Kette non-www → www → trailing-slash (GSC-Umleitungsfehler).
RewriteRule ^reisegruppen$ https://www.ristorantestoria.de/reisegruppen/ [R=301,L]

# ============================================
# 1. Host-Kanonisierung
# ============================================

# 1a. Subdomain Redirects
RewriteCond %{HTTP_HOST} ^newsletter\.ristorantestoria\.de$ [NC]
RewriteRule ^ https://www.ristorantestoria.de/ [R=301,L]

# 1b. HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.ristorantestoria.de/$1 [R=301,L]

# 1c. non-www → www
RewriteCond %{HTTP_HOST} ^ristorantestoria\.de$ [NC]
RewriteRule ^(.*)$ https://www.ristorantestoria.de/$1 [R=301,L]

# ============================================
# 2. WordPress Query-String Redirects (vor Path-Regeln, damit page_id
#    auf jedem Path greift bevor der Path weggestripped wird)
# ============================================
# QSD strippt Query-String, sodass Ziel-URL kein ?page_id-Tail bekommt

# Bekannte Mappings → semantische Ziel-URL
RewriteCond %{QUERY_STRING} (^|&)page_id=2881(&|$)
RewriteRule ^.*$ /impressum/? [R=301,L,QSD]

RewriteCond %{QUERY_STRING} (^|&)page_id=1753(&|$)
RewriteRule ^.*$ /kontakt/? [R=301,L,QSD]

# Catch-All: alle anderen page_ids → Homepage
RewriteCond %{QUERY_STRING} (^|&)page_id=[0-9]+
RewriteRule ^.*$ /? [R=301,L,QSD]

# ============================================
# 3. Legacy URL Redirects
# ============================================
RewriteRule ^mittagsmenu/?$ /mittags-menu/ [R=301,L]
RewriteRule ^busreisen/?$ /reisegruppen/ [R=301,L]
RewriteRule ^weihnachtsmenues/?$ /besondere-anlaesse/weihnachtsmenue/ [R=301,L]
RewriteRule ^silvesterparty/?$ /besondere-anlaesse/silvester/ [R=301,L]
RewriteRule ^lunch-muenchen/?$ /lunch-muenchen-maxvorstadt/ [R=301,L]
RewriteRule ^mittagessen-maxvorstadt/?$ /lunch-muenchen-maxvorstadt/ [R=301,L]
RewriteRule ^eventlocation-muenchen/?$ /eventlocation-muenchen-maxvorstadt/ [R=301,L]
RewriteRule ^italiener-muenchen/?$ / [R=301,L]
# Keyword-Konsolidierung „italiener münchen" → Startseite (auch EN/IT/FR-Versionen)
RewriteRule ^(en|it|fr)/(italian-restaurant-munich|ristorante-italiano-monaco|restaurant-italien-munich)/?$ /$1/ [R=301,L]
# Phantom-URL + Osterbrunch → Ostermontag-Menu
RewriteRule ^besondere-anlaesse/neuer-anlass/?$ /besondere-anlaesse/ostermontag-menue/ [R=301,L]
RewriteRule ^it/occasioni-speciali/neuer-anlass/?$ /it/occasioni-speciali/menu-di-pasqua/ [R=301,L]
RewriteRule ^en/special-occasions/neuer-anlass/?$ /en/special-occasions/easter-monday-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/neuer-anlass/?$ /fr/occasions-speciales/menu-de-paques/ [R=301,L]
RewriteRule ^besondere-anlaesse/osterbrunch/?$ /besondere-anlaesse/ostermontag-menue/ [R=301,L]
RewriteRule ^en/special-occasions/easter-brunch/?$ /en/special-occasions/easter-monday-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/pranzo-di-pasqua/?$ /it/occasioni-speciali/menu-di-pasqua/ [R=301,L]
RewriteRule ^fr/occasions-speciales/brunch-de-paques/?$ /fr/occasions-speciales/menu-de-paques/ [R=301,L]
# Alte Subdomain-URL Struktur
RewriteRule ^ristorantestoria-de/(.+)$ /$1 [R=301,L,QSD]
RewriteRule ^ristorantestoria-de/?$ / [R=301,L,QSD]
# /menu → /speisekarte (Thin Content entfernt)
RewriteRule ^menu/?$ /speisekarte/ [R=301,L]
RewriteRule ^en/menu/?$ /speisekarte/ [R=301,L]
RewriteRule ^it/menu/?$ /speisekarte/ [R=301,L]
RewriteRule ^fr/menu/?$ /speisekarte/ [R=301,L]

# ============================================
# 4. Legacy CMS Redirects (WordPress)
# ============================================
RewriteRule ^cms/speisekarte/?$ /speisekarte/ [R=301,L]
RewriteRule ^cms/1753-2/?$ /kontakt/ [R=301,L]
RewriteRule ^cms/wp-content/uploads/2025/12/Mittagskarte-01\.12\.2025\.pdf$ /mittags-menu/ [R=301,L]
# 410 Gone — endgültig entfernte Mittagskarten-/Aperitivo-PDFs (aus GSC-Index nehmen).
# MUSS vor dem cms/wp-content/uploads-Catch-All (weiter unten) stehen, sonst greift dort 301.
RewriteRule ^cms/wp-content/uploads/2025/02/Mittagskarte-Deutsch-26\.02\.2025-din\.pdf$ - [G]
RewriteRule ^cms/wp-content/uploads/2025/03/Mittagskarte-Deutsch-25\.03\.2025-din\.pdf$ - [G]
RewriteRule ^cms/wp-content/uploads/2025/09/Mittagskarte-18\.09\.2025-din\.pdf$ - [G]
RewriteRule ^cms/wp-content/uploads/2025/10/Mittagskarte-08\.10\.2025-din\.pdf$ - [G]
RewriteRule ^cms/wp-content/uploads/2025/10/Mittagskarte-27\.10\.2025-din\.pdf$ - [G]
RewriteRule ^cms/wp-content/uploads/2025/10/STORIA_Spritz_Notturno-2-pagine\.pdf$ - [G]
RewriteRule ^cms/getraenke/?$ /getraenke/ [R=301,L]
RewriteRule ^cms/weihnachtsmenues-2/?$ /besondere-anlaesse/weihnachtsmenue/ [R=301,L]
RewriteRule ^cms/impressum/?$ /impressum/ [R=301,L]
RewriteRule ^cms/our-team/?$ /ueber-uns/ [R=301,L]
RewriteRule ^cms/reservations/?$ /reservierung/ [R=301,L]
RewriteRule ^cms/events(-2)?/?$ /besondere-anlaesse/ [R=301,L]
RewriteRule ^cms/catering/?$ /catering/ [R=301,L]
RewriteRule ^cms/menue/?$ /mittags-menu/ [R=301,L]
RewriteRule ^cms/speisekarte-2/?$ /speisekarte/ [R=301,L]
RewriteRule ^cms/front-page-2/?$ /? [R=301,L]
RewriteRule ^cms/wp-content/uploads/ /mittags-menu/ [R=301,L]
RewriteRule ^cms/?$ /? [R=301,L]
RewriteRule ^cms/(.+)$ /? [R=301,L]

# ============================================
# 4. Trailing Slash erzwingen
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ============================================
# 5. Multi-Language Slug Redirects
# ============================================

# --- Valentinstag ---
RewriteRule ^en/special-occasions/valentinstag-menue/?$ /en/special-occasions/valentines-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/valentinstag-menue/?$ /it/occasioni-speciali/san-valentino-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/valentinstag-menue/?$ /fr/occasions-speciales/saint-valentin-menu/ [R=301,L]

# --- Weihnachten ---
RewriteRule ^en/special-occasions/weihnachtsmenue/?$ /en/special-occasions/christmas-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/weihnachtsmenue/?$ /it/occasioni-speciali/natale-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/weihnachtsmenue/?$ /fr/occasions-speciales/noel-menu/ [R=301,L]

# --- Silvester ---
RewriteRule ^en/special-occasions/silvester/?$ /en/special-occasions/new-years-eve/ [R=301,L]
RewriteRule ^it/occasioni-speciali/silvester/?$ /it/occasioni-speciali/capodanno/ [R=301,L]
RewriteRule ^fr/occasions-speciales/silvester/?$ /fr/occasions-speciales/nouvel-an/ [R=301,L]

# --- Ostern ---
RewriteRule ^en/special-occasions/ostern-menue/?$ /en/special-occasions/easter-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/ostern-menue/?$ /it/occasioni-speciali/pasqua-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/ostern-menue/?$ /fr/occasions-speciales/paques-menu/ [R=301,L]

# --- Muttertag ---
RewriteRule ^en/special-occasions/muttertag-menue/?$ /en/special-occasions/mothers-day-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/muttertag-menue/?$ /it/occasioni-speciali/festa-mamma-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/muttertag-menue/?$ /fr/occasions-speciales/fete-meres-menu/ [R=301,L]

# --- Vatertag ---
RewriteRule ^en/special-occasions/vatertag-menue/?$ /en/special-occasions/fathers-day-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/vatertag-menue/?$ /it/occasioni-speciali/festa-papa-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/vatertag-menue/?$ /fr/occasions-speciales/fete-peres-menu/ [R=301,L]

# --- Reservierung ---
RewriteRule ^en/reservierung/?$ /en/reservation/ [R=301,L]
RewriteRule ^it/reservierung/?$ /it/prenotazione/ [R=301,L]
RewriteRule ^fr/reservierung/?$ /fr/reservation/ [R=301,L]

# --- Abgelaufene Seiten ---
RewriteRule ^en/besondere-anlaesse/winter-dinner-experience/?$ /en/special-occasions/ [R=301,L]

# ============================================
# 6. Alte Seasonal Slugs → Neue permanente Slugs
# ============================================
# Weihnachten: Plural → Singular
RewriteRule ^besondere-anlaesse/weihnachtsmenues/?$ /besondere-anlaesse/weihnachtsmenue/ [R=301,L]
RewriteRule ^en/special-occasions/christmas-menus/?$ /en/special-occasions/christmas-menu/ [R=301,L]
RewriteRule ^en/special-occasions/weihnachtsmenues/?$ /en/special-occasions/christmas-menu/ [R=301,L]
RewriteRule ^it/occasioni-speciali/weihnachtsmenues/?$ /it/occasioni-speciali/natale-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/noel-menus/?$ /fr/occasions-speciales/noel-menu/ [R=301,L]
RewriteRule ^fr/occasions-speciales/weihnachtsmenues/?$ /fr/occasions-speciales/noel-menu/ [R=301,L]

# Silvester: -party → ohne
RewriteRule ^besondere-anlaesse/silvesterparty/?$ /besondere-anlaesse/silvester/ [R=301,L]
RewriteRule ^en/special-occasions/silvesterparty/?$ /en/special-occasions/new-years-eve/ [R=301,L]
RewriteRule ^en/special-occasions/new-years-party/?$ /en/special-occasions/new-years-eve/ [R=301,L]
RewriteRule ^it/occasioni-speciali/silvesterparty/?$ /it/occasioni-speciali/capodanno/ [R=301,L]
RewriteRule ^it/occasioni-speciali/capodanno-party/?$ /it/occasioni-speciali/capodanno/ [R=301,L]
RewriteRule ^fr/occasions-speciales/silvesterparty/?$ /fr/occasions-speciales/nouvel-an/ [R=301,L]
RewriteRule ^fr/occasions-speciales/nouvel-an-party/?$ /fr/occasions-speciales/nouvel-an/ [R=301,L]

# ============================================
# 8. Legal Pages — Nur DE
# ============================================
RewriteRule ^en/imprint/?$ /impressum/ [R=301,L]
RewriteRule ^it/note-legali/?$ /impressum/ [R=301,L]
RewriteRule ^fr/mentions-legales/?$ /impressum/ [R=301,L]

RewriteRule ^en/privacy-policy/?$ /datenschutz/ [R=301,L]
RewriteRule ^it/privacy/?$ /datenschutz/ [R=301,L]
RewriteRule ^fr/confidentialite/?$ /datenschutz/ [R=301,L]

RewriteRule ^en/cookie-policy/?$ /cookie-richtlinie/ [R=301,L]
RewriteRule ^it/cookie-policy/?$ /cookie-richtlinie/ [R=301,L]
RewriteRule ^fr/politique-cookies/?$ /cookie-richtlinie/ [R=301,L]

RewriteRule ^en/terms-restaurant/?$ /agb-restaurant/ [R=301,L]
RewriteRule ^it/termini-ristorante/?$ /agb-restaurant/ [R=301,L]
RewriteRule ^fr/cgv-restaurant/?$ /agb-restaurant/ [R=301,L]

RewriteRule ^en/terms-vouchers/?$ /agb-gutscheine/ [R=301,L]
RewriteRule ^it/termini-buoni/?$ /agb-gutscheine/ [R=301,L]
RewriteRule ^fr/cgv-bons/?$ /agb-gutscheine/ [R=301,L]

RewriteRule ^en/cancellation-policy/?$ /widerrufsbelehrung/ [R=301,L]
RewriteRule ^it/diritto-recesso/?$ /widerrufsbelehrung/ [R=301,L]
RewriteRule ^fr/droit-retractation/?$ /widerrufsbelehrung/ [R=301,L]

RewriteRule ^en/payment-info/?$ /zahlungsinformationen/ [R=301,L]
RewriteRule ^it/info-pagamento/?$ /zahlungsinformationen/ [R=301,L]
RewriteRule ^fr/infos-paiement/?$ /zahlungsinformationen/ [R=301,L]

RewriteRule ^en/food-info/?$ /lebensmittelhinweise/ [R=301,L]
RewriteRule ^it/info-alimenti/?$ /lebensmittelhinweise/ [R=301,L]
RewriteRule ^fr/infos-alimentaires/?$ /lebensmittelhinweise/ [R=301,L]

RewriteRule ^en/disclaimer/?$ /haftungsausschluss/ [R=301,L]
RewriteRule ^it/disclaimer/?$ /haftungsausschluss/ [R=301,L]
RewriteRule ^fr/avertissement/?$ /haftungsausschluss/ [R=301,L]

# ============================================
# 9. Error Documents
# ============================================
# Echte 404-Seite (gebrandet, noindex, kein Canonical) statt Startseiten-Fallback.
ErrorDocument 404 /404.html
ErrorDocument 500 /index.html

# ============================================
# 10. SPA-Routing, SSG-Support & echte 404s
# ============================================
# 10a. Existierende Dateien direkt ausliefern (Assets, 404.html, robots.txt, …).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 10b. Existierende Verzeichnisse (Prerender-Ordner mit index.html) direkt ausliefern.
#      DirectoryIndex liefert dort die vorgerenderte index.html mit Status 200.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 10c. Client-only SPA-Routen (NICHT prerendert) → index.html, React übernimmt.
#      Diese Pfade existieren nur im React-Router und dürfen KEINE 404 liefern:
#      Admin-Bereich, Double-Opt-in-Bestätigung (Link aus E-Mail!),
#      Formular-Danke-Seite, Kampagnen-Kurz-URL /filmfest.
RewriteRule ^admin(/.*)?$ admin/index.html [L]
RewriteRule ^reisegruppen/danke/?$ index.html [L]
RewriteRule ^newsletter-bestaetigen/?$ index.html [L]
RewriteRule ^(en/confirm-newsletter|it/conferma-newsletter|fr/confirmation-newsletter)/?$ index.html [L]
RewriteRule ^filmfest/?$ index.html [L]

# 10d. Alle übrigen unbekannten Pfade: echte 404 (kein Startseiten-Catch-all mehr).
#      Apache liefert den ErrorDocument 404 (/404.html) aus Abschnitt 9 aus.
RewriteRule ^ - [R=404,L]

# ============================================
# 11. MIME-Types
# ============================================
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# ============================================
# 12. GZIP-Komprimierung
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ============================================
# 13. Browser-Caching
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ============================================
# 14. Security Headers
# ============================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# ============================================
# 14b. Cache-Control — gehashte Build-Assets + HTML-Freshness
# Ergänzt das mod_expires-Caching (Abschnitt 13). Vite hasht JS/CSS/Fonts im
# Dateinamen → dürfen 1 Jahr immutable gecacht werden. HTML (Prerender) darf NICHT
# aggressiv gecacht werden, sonst sehen wiederkehrende Nutzer veraltete Stände.
# Bilder/Videos behalten ihr mod_expires-Caching (bewusst nicht herabgesetzt).
# ============================================
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================
# 14c. Content-Security-Policy — REPORT-ONLY (Stufe 1, blockt NICHTS)
# Bewusst Report-Only: meldet Verstöße, ohne die Seite zu brechen. Erlaubt:
#   - Inline gtag-Consent-Script via sha256-Hash (kein 'unsafe-inline' für Scripts)
#   - GA4, Microsoft Clarity, Elfsight (Reviews), OpenTable (Reservierung), Google Maps
#   - Supabase (connect), lokale Fonts, https-Bilder (Map-Tiles/Avatare/Pixel)
# ENFORCING BLOCKIERT (Voraussetzung vor Umstellung auf "Content-Security-Policy"):
#   Der Prerender injiziert pro Menü-Seite ein Inline-<script>window.__REACT_QUERY_STATE__=…</script>.
#   Ohne Hash/Nonce blockt strict script-src diese -> Hydration-Bruch. Vor dem Enforcen
#   muss die Dehydration auf <script type="application/json"> umgestellt werden
#   (prerender.js + entry-client). Bis dahin: Report-Only laufen lassen, Reports auswerten.
# ============================================
<IfModule mod_headers.c>
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-yew/S/91uxxpETutMdUL9GsQZSCbR7Zf0cOCmdKFyWc=' https://www.googletagmanager.com https://www.clarity.ms https://static.elfsight.com https://www.opentable.de; style-src 'self' 'unsafe-inline' https://static.elfsight.com; img-src 'self' data: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://iieethejhwfsyzhbweps.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.clarity.ms https://*.elfsight.com; frame-src https://www.google.com https://www.opentable.de https://*.opentable.com https://*.elfsight.com; form-action 'self' https://www.opentable.de"
</IfModule>

# ============================================
# 15. Sitemap - Force XML Content-Type
# ============================================
<Files "sitemap.xml">
  ForceType application/xml
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</Files>

AddCharset UTF-8 .xml
